APP_VERSION=
BIND_HOST=
CALLBACK_BASE_URL=
CARDZONE_INQUIRY_URL=
CARDZONE_MERC_REQ_URL=
CARDZONE_MKREQ_URL=
# Static last-resort key (Base64URL SPKI) for verifying the MPIRes / callback
# MAC. Cardzone UAT returns a per-transaction key from mkReq, so a static value
# here will usually NOT match; leave empty and rely on the durable store unless
# Cardzone confirms a stable per-merchant key.
CARDZONE_PUBLIC_KEY=
CARDZONE_PROXY_HOST=
CARDZONE_PROXY_PORT=
DATA_DIR=
ENABLE_MKREQ_MAC=
ENVIRONMENT=
HTTPS_PROXY=
HTTP_PROXY=
# Durable cross-invocation state store (Vercel KV / Upstash Redis REST API).
# Required for a reliable flow on serverless; without it transaction state is
# kept only in the invocation's own /tmp and is lost between requests.
KV_REST_API_URL=
KV_REST_API_TOKEN=
MERCHANT_ID=
# Comma-separated list of merchant IDs enrolled with Cardzone for UAT (must be
# present in BOTH the acquirer system and the MPI enrol screen).
UAT_ENROLLED_MERCHANT_IDS=
MERCHANT_PRIVATE_KEY_PEM_PATH=
MPI_MAC_INCLUDE_RESPONSE_TYPE=
MPI_MAC_PURCHASE_DATE_TIMEZONE=
RETURN_BASE_URL=
USE_CARDZONE_PROXY=